<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="16dp" android:layout_marginBottom="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/word" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#193F36" android:textSize="22sp" android:textStyle="bold"/><Button android:id="@+id/audio" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Play audio" android:textAllCaps="false" android:backgroundTint="#DCE7DA" android:textColor="#193F36"/></LinearLayout>
 <TextView android:id="@+id/partOfSpeech" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#246A5B" android:textSize="12sp" android:textStyle="italic" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/definition" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#193F36" android:textSize="16sp" android:layout_marginTop="8dp"/>
 <TextView android:id="@+id/example" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#5C7067" android:textSize="14sp" android:layout_marginTop="7dp"/>
 <TextView android:id="@+id/synonyms" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#246A5B" android:textSize="13sp" android:layout_marginTop="10dp"/>
</LinearLayout>
