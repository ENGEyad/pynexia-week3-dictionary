<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F4F5EE" android:padding="20dp">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PYNEXIA / WORD DESK" android:textColor="#246A5B" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.1" android:layout_marginTop="10dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find the
right word." android:textColor="#193F36" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="14dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Definitions, pronunciation and related words." android:textColor="#5C7067" android:textSize="14sp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><EditText android:id="@+id/wordInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:singleLine="true" android:hint="Search an English word" android:inputType="text" android:padding="12dp" android:background="@drawable/input" android:importantForAutofill="no"/><Button android:id="@+id/search" android:layout_width="wrap_content" android:layout_height="52dp" android:text="Search" android:textAllCaps="false" android:layout_marginStart="8dp" android:backgroundTint="#246A5B" android:textColor="#FFFFFF"/></LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RECENT SEARCHES" android:textColor="#246A5B" android:textStyle="bold" android:textSize="11sp" android:layout_marginTop="18dp"/>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:id="@+id/history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Look up a word to see its meanings." android:textColor="#5C7067" android:textSize="13sp" android:paddingTop="8dp" android:paddingBottom="4dp"/>
 <ProgressBar android:id="@+id/searchProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone"/>
 <Button android:id="@+id/retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Try again" android:textAllCaps="false" android:visibility="gone"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/definitions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp"/>
</LinearLayout>
